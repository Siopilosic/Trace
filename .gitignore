# ---------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------
# Xcode - build products & generated files
# ---------------------------------------------------------------------
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace

# ---------------------------------------------------------------------
# Xcode - user-specific state (per-developer, never shared)
# ---------------------------------------------------------------------
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Keep shared schemes (xcshareddata/xcschemes) but ignore everything else generated
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# ---------------------------------------------------------------------
# Swift Package Manager
# ---------------------------------------------------------------------
.build/
.swiftpm/
Packages/
Package.resolved
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# ---------------------------------------------------------------------
# CocoaPods / Carthage / Accio (not used here, ignored defensively)
# ---------------------------------------------------------------------
Pods/
Carthage/Build/

# ---------------------------------------------------------------------
# Fastlane / other tooling output
# ---------------------------------------------------------------------
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ---------------------------------------------------------------------
# Secrets / credentials — never commit
# ---------------------------------------------------------------------
*.xcconfig.local
secrets.plist
Secrets.plist
GoogleService-Info.plist
*.p12
*.mobileprovision
*.cer
.env
.env.*
!.env.example
